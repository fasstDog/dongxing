<view class="page results-page">
  <van-notice-bar wx:if="{{ notice }}" left-icon="volume-o" text="{{ notice }}" color="#ed6a0c" background="#fffbe8" />
  <view class="od-block" wx:if="{{ odLine }}">
    <view class="od-line">{{ odLine }}</view>
    <view class="via-row" wx:if="{{ vias.length }}">
      <text class="via-label">途经</text>
      <block wx:for="{{ vias }}" wx:key="*this">
        <text class="via-chip">{{ item }}</text>
      </block>
    </view>
  </view>

  <view class="state-wrap" wx:if="{{ status === 'loading' }}">
    <van-loading type="spinner" size="24px" vertical>正在组合方案…</van-loading>
    <view class="loading-hint">最省钱 / 最快 / 最综合 · 只荐不卖</view>
  </view>

  <view class="state-wrap" wx:elif="{{ status === 'error' }}">
    <van-empty image="error" description="这趟没查到，多半是数据暂不可用">
      <view class="empty-desc">价格、时刻都是参考，不保证有票。也可以改条件再查。</view>
      <view class="empty-actions">
        <van-button round type="primary" bind:click="onRetry">再试一次</van-button>
        <van-button round plain type="primary" bind:click="onBackQuery">改条件</van-button>
      </view>
    </van-empty>
  </view>

  <view class="state-wrap" wx:elif="{{ status === 'empty' }}">
    <van-empty description="这趟暂时拼不出方案">
      <view class="empty-desc">可能是城市名不好认、日期太偏，或这条线我们还没覆盖好。价格时刻都是参考，不保证有票。</view>
      <view class="empty-actions">
        <van-button round plain type="primary" block bind:click="onBackQuery">改查询条件</van-button>
        <van-button round plain type="primary" block data-od="xz" bind:click="onEmptySample">看看示例：徐州→拉萨</van-button>
        <van-button round plain type="primary" block data-od="sh" bind:click="onEmptySample">看看示例：上海→成都</van-button>
        <van-button round plain type="primary" block data-od="bj" bind:click="onEmptySample">看看示例：北京→武汉</van-button>
        <van-button round plain type="primary" block data-od="cd" bind:click="onEmptySample">看看示例：成都→重庆</van-button>
      </view>
    </van-empty>
  </view>

  <block wx:elif="{{ status === 'ok' }}">
    <view class="legend">
      <text class="lg cheap">最省钱</text>
      <text class="lg fast">最快</text>
      <text class="lg balanced">最综合</text>
    </view>
    <view
      wx:for="{{ plans }}"
      wx:key="id"
      class="plan-card"
      data-id="{{ item.id }}"
      bindtap="onOpenDetail"
    >
      <view class="plan-accent accent-{{ item.type }}"></view>
      <view class="plan-body">
        <view class="plan-head">
          <view class="tags">
            <view class="type-pill type-{{ item.type }}">{{ item.typeLabel }}</view>
            <van-tag wx:if="{{ item.hasTransfer }}" plain type="primary">换乘</van-tag>
            <van-tag wx:if="{{ item.hasFlight }}" plain type="warning">飞机</van-tag>
          </view>
          <view class="price-wrap">
            <text class="price">{{ item.price }}</text>
            <text class="price-note">{{ item.priceNote || '参考价' }}</text>
          </view>
        </view>
        <view class="route">{{ item.routeOneLine }}</view>
        <view class="meta">
          <text>{{ item.duration }}</text>
          <text class="dot">·</text>
          <text>{{ item.transfers }} 次换乘</text>
        </view>
        <view class="vs" wx:if="{{ item.vsDirect }}">vs直达：{{ item.vsDirect }}</view>
        <view class="why" wx:if="{{ item.why }}">{{ item.why }}</view>
        <view class="hint" wx:if="{{ item.playHint }}">怎么玩：{{ item.playHint }}</view>
        <view class="card-foot muted">点按看详情 · 外链购票 · 我们不卖票</view>
      </view>
    </view>
  </block>

  <view class="disclaimer">只推荐路线，不卖票。价格、时刻都是参考，不保证有票。</view>
  <van-toast id="van-toast" />
</view>
