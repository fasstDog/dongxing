.od-line {
  margin: 24rpx 8rpx 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.plan-card {
  margin: 24rpx 0;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.plan-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.price {
  font-size: 34rpx;
  font-weight: 700;
  color: #323233;
}

.route {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.meta {
  color: #646566;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.dot {
  margin: 0 8rpx;
}

.why {
  font-size: 26rpx;
  line-height: 1.55;
  color: #323233;
}

.hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #1989fa;
}

.card-foot {
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #ebedf0;
}

.muted {
  color: #969799;
  font-size: 22rpx;
}
