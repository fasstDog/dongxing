.form-block {
  margin-top: 24rpx;
}

.via-block {
  margin-top: 32rpx;
}

.via-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 16rpx;
}

.via-title {
  font-weight: 600;
  font-size: 28rpx;
}

.via-empty {
  padding: 16rpx 32rpx;
}

.muted {
  color: #969799;
  font-size: 24rpx;
}

.sample-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 32rpx 16rpx 0;
}

.sample-text {
  color: #646566;
  font-size: 24rpx;
}

.action {
  margin: 48rpx 16rpx 0;
}
